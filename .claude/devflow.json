{
  "$schema": "./devflow.schema.json",
  "devflowVersion": "3.0.0",
  "github": {
    "owner": "nhanle-agilityio",
    "repo": "devflow"
  },
  "baseBranch": "main",
  "risk": {
    "highPaths": [
      ".github/**",
      "hooks/**",
      "skills/init/templates/github/**"
    ]
  },
  "mergeGate": {
    "enabled": true,
    "dryRun": false,
    "requiredChecks": [
      "devflow/review",
      "test (python 3.9, ubuntu-24.04)",
      "test (python 3.13, ubuntu-latest)"
    ]
  },
  "checks": [
    {
      "name": "node-tests",
      "run": "node --test tests/*.test.cjs"
    },
    {
      "name": "hook-tests",
      "run": "python3 -m unittest discover -s hooks -p 'test_*.py' -v"
    }
  ],
  "scan": {
    "ignore": [
      "tests/engine.test.cjs",
      "tests/scan.test.cjs"
    ]
  },
  "changelog": {
    "fragmentsDir": "changelog.d"
  },
  "dispatch": {
    "ignoreHotspots": [
      "README.md",
      "CHANGELOG.md",
      "DESIGN.md",
      "docs/**",
      "skills/init/templates/devflow.schema.json",
      "skills/init/templates/devflow.json",
      "changelog.d/**"
    ]
  }
}
