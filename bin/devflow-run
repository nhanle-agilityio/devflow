#!/usr/bin/env node
'use strict';
// devflow-run: deterministic steps for the next-task engine. Node, no dependencies.
// Usage: devflow-run check [--config .claude/devflow.json]
//        devflow-run branch --issue <n> --name <branch> --from <ref> [--parents <ref,...>] [--remote origin]
//        devflow-run restore --to <branch>
//        devflow-run commit < payload.json   (paths may be absolute under the repository root; optional testLock
//                                             names a lock held during the red check)
//        devflow-run push --branch <branch> [--remote origin]
//        devflow-run pr-body [--template <path>] < payload.json
//        devflow-run lock acquire --name <name> [--wait <seconds>]
//        devflow-run lock release --name <name>
//        devflow-run park --issue <n> --stage <stage>   (stashes uncommitted work as "devflow #<n> blocked at <stage>")
// check: a check with "lock": "<name>" holds that lock while it runs.
// Prints one JSON object. Exit 1 means the operation could not run.

const { spawn, spawnSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { performance } = require('node:perf_hooks');
const { setTimeout: delay } = require('node:timers/promises');
const { parseArgs } = require('node:util');

const CONFIG_PATH = '.claude/devflow.json';
const DEFAULT_TIMEOUT = 600;
const LOCK_NAME = /^[a-zA-Z0-9_-]+$/;

function readConfig(file) {
  try {
    const config = JSON.parse(fs.readFileSync(file, 'utf8'));
    if (!config || typeof config !== 'object' || Array.isArray(config)) {
      throw new Error('expected an object');
    }
    return config;
  } catch (error) {
    throw new Error(`Invalid config ${file}: ${error.message}`);
  }
}

function runCheck({ name, run: command, timeoutSeconds = DEFAULT_TIMEOUT }, cwd) {
  return new Promise((resolve, reject) => {
    const start = performance.now();
    const child = spawn('/bin/sh', ['-c', 'exec /bin/sh -c "$1" 2>&1', 'devflow-run', command], {
      detached: true,
      cwd,
      stdio: ['ignore', 'pipe', 'ignore'],
    });
    let timedOut = false;
    let tail = [''];
    child.stdout.setEncoding('utf8');
    child.stdout.on('data', (chunk) => {
      const partial = tail.pop();
      tail = tail.concat((partial + chunk).split(/\r?\n/)).slice(-61);
    });
    let timer;
    const deadline = start + timeoutSeconds * 1000;
    function scheduleTimeout() {
      timer = setTimeout(() => {
        if (performance.now() < deadline) return scheduleTimeout();
        timedOut = true;
        try {
          process.kill(-child.pid, 'SIGKILL');
        } catch (error) {
          if (error.code !== 'ESRCH') reject(error);
        }
        child.stdout.destroy();
      }, Math.max(1, Math.min(deadline - performance.now(), 2 ** 31 - 1)));
    }
    scheduleTimeout();
    child.once('error', reject);
    child.once('close', (exitCode) => {
      clearTimeout(timer);
      if (tail.at(-1) === '') tail.pop();
      resolve({ name, command, exitCode, timedOut, durationMs: Math.round(performance.now() - start), outputTail: tail.slice(-60).join('\n') });
    });
  });
}

function gitResult(...args) {
  const result = spawnSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });
  if (result.error) throw result.error;
  return result;
}

function git(...args) {
  const result = gitResult(...args);
  if (result.status !== 0) throw new Error(result.stderr.trim() || `git ${args[0]} failed`);
  return result.stdout;
}

function optionsFor(args, strings, booleans = []) {
  const options = Object.fromEntries([
    ...strings.map((name) => [name, { type: 'string' }]),
    ...booleans.map((name) => [name, { type: 'boolean' }]),
  ]);
  return parseArgs({ args, options }).values;
}

function checkRefName(name, namespace = 'heads') {
  if (!name || name.startsWith('-') || gitResult('check-ref-format', `refs/${namespace}/${name}`).status !== 0) {
    throw new Error(`Invalid Git name: ${name ?? '(missing)'}`);
  }
  return name;
}

function protectedMatcher(config) {
  const { baseBranch, protectedBranches } = config;
  if (typeof baseBranch !== 'string' || !baseBranch.trim() ||
      (protectedBranches !== undefined && (!Array.isArray(protectedBranches) ||
        protectedBranches.some((pattern) => typeof pattern !== 'string' || !pattern.trim())))) {
    throw new Error('Invalid config: expected baseBranch and optional protectedBranches');
  }
  checkRefName(baseBranch);
  // As in guard.py, * and ? match across slashes, and bracket classes match a single character.
  const escape = (literal) => literal.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const patterns = (protectedBranches ?? ['main', 'master', 'develop']).map((pattern) => {
    const tokens = pattern.match(/\[!?\]?(?:[^\]]+)\]|[\s\S]/g);
    const source = tokens.map((token) => {
      if (token === '*') return '.*';
      if (token === '?') return '.';
      if (token.length > 1) {
        const chars = token.slice(1, -1);
        const negated = chars.startsWith('!');
        const body = (negated ? chars.slice(1) : chars).replace(/[\\\[\]\^]/g, '\\$&');
        return `[${negated ? '^' : ''}${body}]`;
      }
      return escape(token);
    }).join('');
    return new RegExp(`^${source}$`);
  });
  return (name) => name === baseBranch || patterns.some((pattern) => pattern.test(name));
}

function dirtyFiles() {
  const entries = git('status', '--porcelain=v1', '-z', '--untracked-files=all').split('\0');
  const files = new Set();
  for (let i = 0; entries[i]; i++) {
    const entry = entries[i];
    files.add(entry.slice(3));
    if (/[RC]/.test(entry.slice(0, 2))) files.add(entries[++i]);
  }
  return [...files];
}

let topLevel;
function repoPath(file) {
  let value = file.trim();
  if (path.isAbsolute(value)) {
    topLevel ??= fs.realpathSync(git('rev-parse', '--show-toplevel').trimEnd());
    let absolute = path.resolve(value);
    try {
      absolute = fs.realpathSync(absolute);
    } catch {
      const dir = path.dirname(absolute);
      try {
        absolute = path.join(fs.realpathSync(dir), path.basename(absolute));
      } catch {
        // keep the path as given
      }
    }
    const relative = path.relative(topLevel, absolute);
    if (relative && !relative.startsWith('..') && !path.isAbsolute(relative)) value = relative.split(path.sep).join('/');
  }
  while (value.startsWith('./')) value = value.slice(2);
  return value;
}

function commitFor(ref) {
  const result = gitResult('rev-parse', '--verify', '--quiet', '--end-of-options', `${ref}^{commit}`);
  return result.status === 0 ? result.stdout.trim() : null;
}

function runBranch(args) {
  const options = optionsFor(args, ['issue', 'name', 'from', 'parents', 'remote', 'prefix'], ['require-existing']);
  const protectedName = protectedMatcher(readConfig(CONFIG_PATH));
  const issue = options.issue;
  if (!/^[1-9]\d*$/.test(issue ?? '')) throw new Error('Expected a positive issue number');
  let branch = checkRefName(options.name);
  function assertUnprotected(name) {
    if (protectedName(name)) throw new Error(`Refusing protected branch ${name}`);
  }
  assertUnprotected(branch);

  const remote = options.remote ?? 'origin';
  checkRefName(`${remote}/probe`, 'remotes');
  if (!options.from || options.from.startsWith('-')) throw new Error('Expected a starting ref');
  const parents = options.parents === undefined ? [] : options.parents.split(',').map((parent) => checkRefName(parent));
  const prefix = options.prefix ?? (/^[^/]+\//.test(branch) ? `${branch.split('/')[0]}/${issue}-` : '');
  if (prefix) checkRefName(`${prefix}probe`);
  if (dirtyFiles().length) throw new Error('The working tree has uncommitted changes');

  // Use an explicit fetch destination so a custom fetch refspec cannot write a local branch.
  git('remote', 'get-url', remote);
  git('fetch', '--prune', '--no-tags', '--refmap=', '--', remote, `refs/heads/*:refs/remotes/${remote}/*`);
  const remoteRef = (name) => `refs/remotes/${remote}/${name}`;
  const localRef = (name) => `refs/heads/${name}`;
  const from = options.from.startsWith(`${remote}/`) ? `refs/remotes/${options.from}` : options.from;
  const start = commitFor(from);
  if (!start) return { ok: false, error: `Starting ref does not exist: ${options.from}`, missingRef: options.from };
  const parentCommits = parents.map((parent) => {
    const sha = commitFor(remoteRef(parent));
    if (!sha) throw new Error(`Parent ref does not exist: ${remote}/${parent}`);
    return sha;
  });
  function ownCommits(sha) {
    return git('log', '--no-merges', '--format=%h %s', sha, '--not', start, ...parentCommits, '--').trim().split('\n').filter(Boolean);
  }

  let local = commitFor(localRef(branch));
  let tracking = commitFor(remoteRef(branch));
  if (!local && !tracking && options['require-existing']) throw new Error(`Branch does not exist: ${branch}`);
  if (!local && !tracking && prefix) {
    const scoped = new RegExp(`^[a-f0-9]+ [a-z][a-z0-9-]*\\(#${issue}\\)!?:`, 'i');
    const candidates = new Set();
    const refs = git('for-each-ref', '--format=%(refname) %(objectname)', 'refs/heads', `refs/remotes/${remote}`);
    for (const line of refs.trim().split('\n')) {
      const [ref, sha] = line.split(' ');
      const name = ref.replace(ref.startsWith('refs/heads/') ? 'refs/heads/' : `refs/remotes/${remote}/`, '');
      if (name.startsWith(prefix) && !protectedName(name) && ownCommits(sha).some((commit) => scoped.test(commit))) {
        candidates.add(name);
      }
    }
    if (candidates.size > 1) return { ok: false, error: 'Multiple matching branches', candidates: [...candidates].sort() };
    if (candidates.size === 1) {
      [branch] = candidates;
      assertUnprotected(branch);
      local = commitFor(localRef(branch));
      tracking = commitFor(remoteRef(branch));
    }
  }

  const action = local || tracking ? 'resumed' : 'created';
  let remoteAhead = false;
  if (local && tracking && local !== tracking) {
    remoteAhead = gitResult('merge-base', '--is-ancestor', local, tracking).status === 0;
    if (!remoteAhead && gitResult('merge-base', '--is-ancestor', tracking, local).status !== 0) {
      throw new Error(`Local and remote history diverged for ${branch}`);
    }
  }

  if (local) git('switch', '--no-guess', '--', branch);
  else if (tracking) git('switch', '-c', branch, '--track', remoteRef(branch));
  else git('switch', '--no-track', '-c', branch, start);
  if (remoteAhead) git('-c', 'merge.autostash=false', 'merge', '--ff-only', tracking);
  const commits = action === 'resumed' ? ownCommits(git('rev-parse', 'HEAD').trim()) : [];
  const conflicts = [];
  for (const [index, parent] of parents.entries()) {
    const merge = gitResult('-c', 'merge.autostash=false', '-c', 'rerere.enabled=false', 'merge', '--no-edit', parentCommits[index]);
    if (merge.status === 0) continue;
    const files = git('diff', '--name-only', '--diff-filter=U', '-z').split('\0').filter(Boolean);
    if (commitFor('MERGE_HEAD')) git('merge', '--abort');
    if (!files.length) throw new Error(merge.stderr.trim() || `Could not merge ${remote}/${parent}`);
    conflicts.push({ parent, files });
  }
  return { ok: true, branch, action, head: git('rev-parse', 'HEAD').trim(), commits, conflicts };
}

function runRestore(args) {
  const { to } = optionsFor(args, ['to']);
  protectedMatcher(readConfig(CONFIG_PATH));
  const branch = checkRefName(to);
  const files = dirtyFiles();
  if (files.length) return { ok: true, restored: false, reason: 'uncommitted changes', files };
  // Switching to a protected branch changes the checkout only and never writes that branch ref.
  git('switch', '--no-guess', '--', branch);
  return { ok: true, restored: true };
}

function runPush(args) {
  const options = optionsFor(args, ['branch', 'remote']);
  const protectedName = protectedMatcher(readConfig(CONFIG_PATH));
  const branch = checkRefName(options.branch);
  const remote = options.remote ?? 'origin';
  if (protectedName(branch)) throw new Error(`Refusing protected branch ${branch}`);
  if (git('symbolic-ref', 'HEAD').trimEnd() !== `refs/heads/${branch}`) {
    throw new Error(`Branch ${branch} is not the current branch`);
  }
  if (!remote) throw new Error('Expected a remote');
  git('push', '-u', '--no-follow-tags', '--', remote, `refs/heads/${branch}:refs/heads/${branch}`);
  return { ok: true, branch, remote, pushed: true };
}

function runPrBody(args) {
  const { template } = optionsFor(args, ['template']);
  const {
    issue, type, scope, summary, how, riskLine, stackLine, isFix, rootCause, tests, checks,
    verification, manualChecks, reviewNotes, decisions, assumptions, outOfScope, reviewTrace, runMarker, closes,
  } = JSON.parse(fs.readFileSync(0, 'utf8'));
  const isLine = (value) => typeof value === 'string' && !/[\r\n]/.test(value);
  if (!isLine(issue?.title) || !isLine(type) || !isLine(scope) || !isLine(runMarker) ||
      !Array.isArray(reviewTrace) || reviewTrace.length !== 3 || !reviewTrace.every(isLine) ||
      !Array.isArray(closes) || !closes.length || closes[0] !== issue.number ||
      !closes.every((number) => Number.isSafeInteger(number) && number > 0)) {
    throw new Error('Invalid PR body payload');
  }
  const list = (items = []) => items.map((item) => /^[-*+]\s/.test(item) ? item : `- ${item}`).join('\n');
  const table = (headers, rows) => {
    if (!rows.length) return '';
    const line = (cells) => '| ' + cells.map((cell) =>
      String(cell).replace(/\|/g, '\\|').replace(/\r?\n/g, '<br>')).join(' | ') + ' |';
    return [headers, headers.map(() => '---'), ...rows].map(line).join('\n');
  };
  const sections = new Map([
    ['What', summary],
    ['How', how],
    ['Risk', [riskLine, stackLine].filter(Boolean).join('\n\n')],
    ['Tests', [list(tests), table(['Row', 'Result', 'Evidence'],
      (manualChecks ?? []).map(({ row, result, evidence }) => [row, result, evidence]))].filter(Boolean).join('\n\n')],
    ['Checks', table(['Check', 'Result'], (checks ?? []).map(({ name, result }) => [name, result]))],
    ['Verification', verification],
    ['Review notes', list(reviewNotes)],
    ['Decisions taken', list(decisions)],
    ['Assumptions', list(assumptions)],
    ['Out of scope', list(outOfScope)],
  ]);
  const fixSections = new Map([
    ['Root cause', rootCause?.cause || 'unknown'],
    ['Introduced by', rootCause?.introducedBy || 'unknown'],
    ['Why it was missed', rootCause?.whyMissed || 'unknown'],
  ]);
  const withoutComments = (value) => value.replace(/<!--[\s\S]*?-->/g, '').trim();
  const headings = template === undefined
    ? [...sections.keys()].map((heading) => [`## ${heading}`, heading])
    : Array.from(withoutComments(fs.readFileSync(template, 'utf8')).matchAll(/^#{1,6}[ \t]+(.+)$/gm),
      ([heading, name]) => [heading, name]);
  const body = [];
  for (const [heading, name] of headings) {
    const section = name.trim();
    if (section === 'Review' || (!isFix && fixSections.has(section))) continue;
    const content = sections.get(section) ?? fixSections.get(section) ?? '';
    const rendered = section === 'Risk' ? content : withoutComments(content);
    body.push(`${heading}\n\n${rendered || 'None'}`);
  }
  body.push(`## Review\n\n${reviewTrace.join('\n')}`, runMarker, closes.map((number) => `Closes #${number}`).join('\n'));
  const subject = issue.title.replace(/^\s*\[[^\]\r\n]+\]\s+T\d+:\s*/i, '');
  const title = Array.from(`${type}(${scope}): ${subject}`).slice(0, 72).join('').trimEnd();
  return { ok: true, title, body: body.join('\n\n') };
}

async function checkRed(sha, setup, testCommand) {
  const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'devflow-red-'));
  const checkout = path.join(temporary, 'checkout');
  try {
    git('worktree', 'add', '--detach', checkout, sha);
    for (const run of setup) {
      const result = await runCheck({ run }, checkout);
      if (result.exitCode !== 0) {
        throw new Error(`Red check setup failed: ${run}\n${result.outputTail}`.trimEnd());
      }
    }
    const result = await runCheck({ run: testCommand }, checkout);
    if (result.exitCode === null) {
      throw new Error(`Red check ${result.timedOut ? 'timed out' : 'was interrupted'}\n${result.outputTail}`.trimEnd());
    }
    return {
      redConfirmed: result.exitCode !== 0,
      redOutput: result.outputTail.split('\n').slice(-40).join('\n'),
    };
  } finally {
    try {
      if (fs.existsSync(checkout)) git('worktree', 'remove', '--force', checkout);
    } finally {
      fs.rmdirSync(temporary);
    }
  }
}

async function runCommit() {
  const config = readConfig(CONFIG_PATH);
  const protectedName = protectedMatcher(config);
  const branch = git('symbolic-ref', 'HEAD').trimEnd().replace(/^refs\/heads\//, '');
  if (protectedName(branch)) throw new Error(`Refusing protected branch ${branch}`);

  const payload = JSON.parse(fs.readFileSync(0, 'utf8'));
  const { scope, type, title, qaFiles: rawQa, devFiles: rawDev, separate, testCommand, setup, testLock } = payload;
  const nonEmptyString = (value) => typeof value === 'string' && !!value.trim();
  const stringList = (value) => Array.isArray(value) && value.every(nonEmptyString);
  if (![scope, type, title, testCommand].every(nonEmptyString) || ![rawQa, rawDev, setup].every(stringList) ||
      typeof separate !== 'boolean' || (testLock !== undefined && (typeof testLock !== 'string' || !LOCK_NAME.test(testLock)))) {
    throw new Error('Invalid commit payload');
  }

  const qaFiles = rawQa.map(repoPath);
  const devFiles = rawDev.map(repoPath);
  const listed = new Set([...qaFiles, ...devFiles]);
  const changed = new Set(dirtyFiles());
  const unlisted = [...changed].filter((file) => !listed.has(file)).sort();
  devFiles.push(...unlisted);
  const result = { ok: true, commits: [], leftover: [], unlisted, redConfirmed: false, redOutput: '' };

  function commit(files, subject) {
    const paths = [...new Set(files)].filter((file) => changed.has(file));
    if (!paths.length) return;
    const message = Array.from(subject.replace(/[\r\n]+/g, ' ')).slice(0, 100).join('').trimEnd();
    for (const file of paths) git('--literal-pathspecs', 'add', '--', file);
    git('--literal-pathspecs', 'commit', '--only', '-m', message, '--', ...paths);
    const sha = git('rev-parse', 'HEAD').trim();
    result.commits.push({ sha, message, files: paths });
    for (const file of paths) changed.delete(file);
    return sha;
  }

  const fragments = config.changelog?.fragmentsDir ?? 'changelog.d';
  const isDoc = (file) => /^[^/]+\.md$/.test(file) || file.startsWith('docs/') ||
    (!/^(skills|agents)\//.test(file) && file.startsWith(`${fragments}/`));
  const testSha = commit(qaFiles, `test(${scope}): tests for ${title}`);
  commit(separate ? devFiles.filter((file) => !isDoc(file)) : devFiles, `${type}(${scope}): ${title}`);
  if (separate) commit(devFiles.filter(isDoc), `docs(${scope}): docs for ${title}`);
  if (testSha) {
    const red = await withLock(testLock, DEFAULT_TIMEOUT, () => checkRed(testSha, setup, testCommand));
    if (red.busy) throw new Error(`Red check lock "${testLock}" was busy (held since ${red.heldSince})`);
    Object.assign(result, red);
  }
  return result;
}

async function runLock([action, ...args]) {
  if (action !== 'acquire' && action !== 'release') throw new Error('Expected lock acquire or release');
  const { name, wait = String(DEFAULT_TIMEOUT) } = optionsFor(args, action === 'acquire' ? ['name', 'wait'] : ['name']);
  if (!name || !LOCK_NAME.test(name)) throw new Error('Invalid lock name');
  if (!/^\d+$/.test(wait) || !Number.isSafeInteger(Number(wait) * 1000)) {
    throw new Error('Expected --wait in non-negative whole seconds');
  }
  if (action === 'release') {
    releaseLock(name);
    return { ok: true, acquired: false };
  }
  return acquireLock(name, Number(wait));
}

function lockPath(name) {
  return path.join(git('rev-parse', '--git-common-dir').trimEnd(), `devflow-${name}.lock`);
}

function releaseLock(name) {
  try {
    fs.rmdirSync(lockPath(name));
  } catch (error) {
    if (error.code !== 'ENOENT') throw error;
  }
}

async function acquireLock(name, waitSeconds) {
  const lock = lockPath(name);
  const deadline = performance.now() + waitSeconds * 1000;
  while (true) {
    try {
      fs.mkdirSync(lock);
      return { ok: true, acquired: true };
    } catch (error) {
      if (error.code !== 'EEXIST') throw error;
    }
    const held = fs.lstatSync(lock, { throwIfNoEntry: false });
    if (!held) continue;
    if (!held.isDirectory()) throw new Error(`Lock path is not a directory: ${lock}`);
    if (Date.now() - held.mtimeMs > 30 * 60 * 1000) {
      releaseLock(name);
      continue;
    }
    const remaining = deadline - performance.now();
    if (remaining <= 0) return { ok: true, acquired: false, heldSince: held.mtime.toISOString() };
    await delay(Math.min(1000, remaining));
  }
}

async function withLock(name, waitSeconds, fn) {
  if (!name) return fn();
  const lock = await acquireLock(name, waitSeconds);
  if (!lock.acquired) return { busy: true, heldSince: lock.heldSince };
  try {
    return await fn();
  } finally {
    releaseLock(name);
  }
}

async function runLockedCheck(check) {
  const { name, run: command, lock, timeoutSeconds = DEFAULT_TIMEOUT } = check;
  const start = performance.now();
  const result = await withLock(lock, timeoutSeconds, () => runCheck(check));
  if (result.busy) {
    return {
      name, command, lock, exitCode: null, timedOut: true, durationMs: Math.round(performance.now() - start),
      outputTail: `Lock "${lock}" was busy (held since ${result.heldSince}) for ${timeoutSeconds} seconds; the check did not run.`,
    };
  }
  return lock ? { ...result, lock } : result;
}

function runPark(args) {
  const { issue, stage } = optionsFor(args, ['issue', 'stage']);
  if (!/^[1-9]\d*$/.test(issue ?? '') || !Number.isSafeInteger(Number(issue))) {
    throw new Error('Expected --issue as a positive integer');
  }
  if (!stage || !stage.trim()) throw new Error('Expected --stage');
  const message = `devflow #${issue} blocked at ${stage.trim()}`;
  if (!git('status', '--porcelain').trim()) return { ok: true, stashed: false, message };
  git('stash', 'push', '-u', '-m', message);
  return { ok: true, stashed: true, message };
}

async function main([subcommand, ...options]) {
  if (subcommand === 'commit' && !options.length) return runCommit();
  if (subcommand === 'lock') return runLock(options);
  if (subcommand === 'branch') return runBranch(options);
  if (subcommand === 'restore') return runRestore(options);
  if (subcommand === 'push') return runPush(options);
  if (subcommand === 'pr-body') return runPrBody(options);
  if (subcommand === 'park') return runPark(options);
  if (subcommand !== 'check' || (options.length && (options.length !== 2 || options[0] !== '--config' || !options[1]))) {
    throw new Error('Usage: devflow-run check [--config .claude/devflow.json]');
  }
  const { checks } = readConfig(options[1] ?? CONFIG_PATH);
  if (!Array.isArray(checks) || !checks.length || checks.some((check) =>
    !check || typeof check.name !== 'string' || !check.name.trim() || typeof check.run !== 'string' || !check.run.trim() ||
    (check.timeoutSeconds !== undefined && (!Number.isInteger(check.timeoutSeconds) || check.timeoutSeconds < 1)) ||
    (check.lock !== undefined && (typeof check.lock !== 'string' || !LOCK_NAME.test(check.lock)))
  )) {
    throw new Error('Invalid config: expected checks with a name, command, optional positive integer timeoutSeconds and ' +
      'optional lock name (letters, digits, _ and -)');
  }

  const results = [];
  for (const check of checks) results.push(await runLockedCheck(check));
  return { ok: true, passed: results.every(({ exitCode, timedOut }) => exitCode === 0 && !timedOut), checks: results };
}

main(process.argv.slice(2)).catch((error) => {
  process.exitCode = 1;
  return { ok: false, error: error.message };
}).then((result) => {
  if (!result.ok) process.exitCode = 1;
  process.stdout.write(JSON.stringify(result) + '\n');
});
