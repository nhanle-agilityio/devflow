#!/usr/bin/env node
'use strict';
// devflow-lanes: group ready issues into lanes that can run in parallel without colliding.
// Input (stdin JSON): {"maxLanes": N, "ignoreHotspots": [string], "issues": [{"number": int, "hotspots": [string], "dependsOn": [int]}]}
// Output (stdout JSON): {"lanes": [{"issues": [int], "sharedHotspots": [string], "ignoredTouched": [string]}], "deferred": [...], "stacked": [{"issue": int, "on": [int]}], "ignoredHotspots": [string], "warnings": [...]}

const USAGE = `Usage: devflow-lanes < input.json

Reads {"maxLanes": N, "ignoreHotspots": ["README.md"], "issues": [{"number": 1, "hotspots": ["a.py"], "dependsOn": [2]}]} from stdin.
Hotspots matching ignoreHotspots (exact path, or glob with * and **; default ["README.md", "CHANGELOG.md"], [] ignores
none) are dropped before grouping and listed in "ignoredHotspots".
Issues that share a hotspot (exact path, trimmed) or form a linear dependency link share a lane.
A linear link has one in-set child per parent and one in-set parent per child.
Fan-out and multi-parent children go to "stacked" unless joined by a hotspot.
inside a lane, parents come first, ties by issue number. Lanes are sorted by smallest issue number; lanes
beyond maxLanes (default 3) go to "deferred". Per lane, "ignoredTouched" lists the ignored hotspots (exact path) that
the lane's issues name and an earlier lane's issues also name, sorted ([] when none). Prints {"lanes", "deferred", "stacked", "ignoredHotspots", "warnings"} as JSON.
Exits 1 on invalid input.`;

const DEFAULT_IGNORE = ['README.md', 'CHANGELOG.md'];

function isPosInt(n) {
  return Number.isInteger(n) && n > 0;
}

function validate(input) {
  if (!input || typeof input !== 'object' || Array.isArray(input)) throw new Error('input must be a JSON object');
  const maxLanes = input.maxLanes === undefined ? 3 : input.maxLanes;
  if (!isPosInt(maxLanes)) throw new Error('maxLanes must be a positive integer');
  const ignoreHotspots = input.ignoreHotspots === undefined ? DEFAULT_IGNORE : input.ignoreHotspots;
  if (!Array.isArray(ignoreHotspots) || ignoreHotspots.some((g) => typeof g !== 'string'))
    throw new Error('ignoreHotspots must be an array of strings');
  if (!Array.isArray(input.issues)) throw new Error('issues must be an array');
  const seen = new Set();
  const issues = input.issues.map((raw, i) => {
    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error(`issues[${i}] must be an object`);
    if (!isPosInt(raw.number)) throw new Error(`issues[${i}].number must be a positive integer`);
    if (seen.has(raw.number)) throw new Error(`duplicate issue number ${raw.number}`);
    seen.add(raw.number);
    const hotspots = raw.hotspots === undefined ? [] : raw.hotspots;
    const dependsOn = raw.dependsOn === undefined ? [] : raw.dependsOn;
    if (!Array.isArray(hotspots) || hotspots.some((h) => typeof h !== 'string'))
      throw new Error(`issues[${i}].hotspots must be an array of strings`);
    if (!Array.isArray(dependsOn) || dependsOn.some((d) => !isPosInt(d)))
      throw new Error(`issues[${i}].dependsOn must be an array of positive integers`);
    return {
      number: raw.number,
      hotspots: [...new Set(hotspots.map((h) => h.trim()).filter(Boolean))],
      dependsOn: [...new Set(dependsOn)],
    };
  });
  return { maxLanes, ignoreHotspots: ignoreHotspots.map((g) => g.trim()).filter(Boolean), issues };
}

// Glob to RegExp: ** matches across directories, * matches within one path segment, ? one non-slash character.
function globToRegExp(glob) {
  let re = '';
  for (let i = 0; i < glob.length; i++) {
    const c = glob[i];
    if (c === '*') {
      if (glob[i + 1] === '*') {
        i++;
        if (glob[i + 1] === '/') {
          i++;
          re += '(?:.*/)?';
        } else re += '.*';
      } else re += '[^/]*';
    } else if (c === '?') re += '[^/]';
    else re += c.replace(/[.+^${}()|[\]\\]/g, '\\$&');
  }
  return new RegExp(`^${re}$`);
}

function planLanes(input) {
  const { maxLanes, ignoreHotspots, issues: rawIssues } = validate(input);
  const ignore = ignoreHotspots.map(globToRegExp);
  const ignored = new Set();
  const issues = rawIssues.map((x) => {
    const ignoredNamed = [];
    const hotspots = x.hotspots.filter((h) => {
      if (!ignore.some((re) => re.test(h))) return true;
      ignored.add(h);
      ignoredNamed.push(h);
      return false;
    });
    return { ...x, hotspots, ignoredNamed };
  });
  const parent = new Map(issues.map((x) => [x.number, x.number]));
  const find = (a) => {
    while (parent.get(a) !== a) {
      parent.set(a, parent.get(parent.get(a)));
      a = parent.get(a);
    }
    return a;
  };
  const union = (a, b) => {
    const ra = find(a);
    const rb = find(b);
    if (ra !== rb) parent.set(Math.max(ra, rb), Math.min(ra, rb));
  };

  const firstByHotspot = new Map();
  const parentsByIssue = new Map();
  const childCounts = new Map();
  for (const x of issues) {
    for (const h of x.hotspots) {
      if (firstByHotspot.has(h)) union(x.number, firstByHotspot.get(h));
      else firstByHotspot.set(h, x.number);
    }
    const deps = x.dependsOn.filter((d) => parent.has(d) && d !== x.number).sort((a, b) => a - b);
    parentsByIssue.set(x.number, deps);
    for (const d of deps) childCounts.set(d, (childCounts.get(d) || 0) + 1);
  }
  // Only a linear link (one in-set child per parent, one in-set parent per child) joins a lane through a dependency.
  for (const [issue, deps] of parentsByIssue) {
    if (deps.length === 1 && childCounts.get(deps[0]) === 1) union(issue, deps[0]);
  }
  // Any other child waits for its parents' PRs, unless hotspots already put it in the same lane as every in-set parent.
  const stacked = new Map();
  for (const [issue, deps] of parentsByIssue) {
    if (deps.some((d) => find(d) !== find(issue))) stacked.set(issue, deps);
  }

  const groups = new Map();
  for (const x of issues) {
    if (stacked.has(x.number)) continue;
    const r = find(x.number);
    if (!groups.has(r)) groups.set(r, []);
    groups.get(r).push(x);
  }

  const warnings = [];
  const all = [...groups.values()].map((members) => {
    const nums = new Set(members.map((m) => m.number));
    const deps = new Map(
      members.map((m) => [m.number, new Set(m.dependsOn.filter((d) => nums.has(d) && d !== m.number))]),
    );
    const order = [];
    const left = new Set(nums);
    while (left.size) {
      const ready = [...left].filter((n) => [...deps.get(n)].every((d) => !left.has(d))).sort((a, b) => a - b);
      if (ready.length) {
        order.push(ready[0]);
        left.delete(ready[0]);
      } else {
        const rest = [...left].sort((a, b) => a - b);
        warnings.push(`dependency cycle among ${rest.map((n) => '#' + n).join(', ')}; kept in number order`);
        order.push(...rest);
        left.clear();
      }
    }
    const counts = new Map();
    for (const m of members) for (const h of m.hotspots) counts.set(h, (counts.get(h) || 0) + 1);
    const sharedHotspots = [...counts].filter(([, c]) => c > 1).map(([h]) => h).sort();
    const named = new Set(members.flatMap((m) => m.ignoredNamed));
    return { issues: order, sharedHotspots, named, min: Math.min(...nums) };
  });
  all.sort((a, b) => a.min - b.min);

  // ignoredTouched: ignored hotspots (exact path) this lane names that an earlier lane also names.
  const seenEarlier = new Set();
  for (const lane of all) {
    lane.ignoredTouched = [...lane.named].filter((h) => seenEarlier.has(h)).sort();
    for (const h of lane.named) seenEarlier.add(h);
  }

  const lanes = all
    .slice(0, maxLanes)
    .map(({ issues: i, sharedHotspots, ignoredTouched }) => ({ issues: i, sharedHotspots, ignoredTouched }));
  const deferred = all
    .slice(maxLanes)
    .map(({ issues: i }) => ({ issues: i, reason: `over maxLanes (${maxLanes})` }));
  const stackedIssues = [...stacked].sort(([a], [b]) => a - b).map(([issue, on]) => ({ issue, on }));
  return { lanes, deferred, stacked: stackedIssues, ignoredHotspots: [...ignored].sort(), warnings };
}

if (require.main !== module) {
  module.exports = { planLanes };
} else {
  if (process.argv.slice(2).some((a) => a === '--help' || a === '-h')) {
    console.log(USAGE);
    process.exit(0);
  }
  let data = '';
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', (c) => (data += c));
  process.stdin.on('end', () => {
    try {
      let parsed;
      try {
        parsed = JSON.parse(data);
      } catch (e) {
        throw new Error(`invalid JSON on stdin: ${e.message}`);
      }
      process.stdout.write(JSON.stringify(planLanes(parsed), null, 2) + '\n');
    } catch (e) {
      console.error(`devflow-lanes: ${e.message}`);
      process.exit(1);
    }
  });
}
