#!/usr/bin/env node
'use strict';
// devflow-setup: deterministic helpers for /devflow:init and /devflow:doctor. Node, no dependencies.
//   allow    < devflow.json                    -> {"permissions": {"allow": [...]}} for .claude/settings.json
//   minimal  <schema.json> < devflow.json      -> the config without keys equal to their schema default
//   leftovers < {"settings", "config", "files"} -> project files and rules the plugin now owns (report only)
// Pure functions allowRules, minimalConfig and ownedLeftovers are exported for tests.

const USAGE = `Usage:
  devflow-setup allow [--github-mcp 'mcp__github__*'] < .claude/devflow.json
  devflow-setup minimal <path to devflow.schema.json> < config.json
  devflow-setup leftovers < {"settings": <settings.json>, "config": <devflow.json>, "files": ["path", ...]}

allow: the Bash and MCP allow rules background sessions need, built from checks, verify, worktree.setup and the
github remote. Never a deny rule (the guard hook blocks merges, force pushes and protected branches), never a rule
that merges or force pushes.
minimal: drops every key whose value equals its schema default (required keys, $schema and devflowVersion stay),
so init writes only what differs from the defaults.
leftovers: lists files and rules a project kept from before the plugin owned them; nothing is deleted.`;

const GIT_RULES = [
  'git status', 'git diff', 'git log', 'git show', 'git fetch', 'git switch', 'git add', 'git commit',
  'git merge', 'git branch', 'git worktree', 'git stash', 'git rev-parse', 'git ls-remote', 'git merge-base',
  'git ls-tree', 'git symbolic-ref',
];

// Split a shell command at && ; || | into its simple commands, each trimmed.
function simpleCommands(run) {
  return String(run || '')
    .split(/&&|\|\||;|\|/)
    .map((s) => s.trim())
    .filter(Boolean);
}

// Programs that run other code: never a bare rule for them.
const RUNNERS = new Set(['python', 'node', 'bash', 'sh', 'zsh', 'npx', 'uv', 'uvx', 'poetry', 'pipx', 'pnpx', 'bun', 'bunx', 'deno', 'ruby', 'perl', 'php']);
// Programs that wrap an arbitrary command: no safe prefix at all.
const WRAPPERS = new Set(['env', 'sudo', 'time', 'nice', 'nohup', 'xargs', 'exec', 'command', 'doas']);
// Words of a runner that come before the real tool (uv run pytest, pnpm dlx x, pipx run y).
const RUNNER_SUBCOMMANDS = new Set(['run', 'exec', 'dlx', 'x', 'tool']);
// Flags that run inline code: nothing after them can be pinned.
const INLINE_CODE = new Set(['-c', '-e', '--eval', '-p', '--print', '--command']);
// Runner flags whose value names the tool (python -m pytest).
const VALUE_FLAGS = new Set(['-m']);
// A runner rule with flags only is specific enough for these.
const SAFE_FLAG_ONLY = new Set(['--test']);

const baseName = (w) => w.split('/').pop();
const isRunner = (w) => RUNNERS.has(baseName(w)) || /^python[\d.]+$/.test(baseName(w));
const hasQuote = (w) => /["'`$]/.test(w);
const isGlob = (w) => /[*?[\]{}]/.test(w) || w === '.' || w === './' || w === ':/';
const isPath = (w) => w.includes('/') || /\.[A-Za-z0-9]+$/.test(w) || w.startsWith('.');

// {rule} for one simple command, or {rule: null, reason} when no safe specific prefix exists.
// Plain tools keep up to two subcommand words (make test, npm run lint, .venv/bin/ruff check). Runners keep their
// flags and the tool they run, up to the first path or glob (python3 -m pytest, node --test, npx --yes prettier,
// uv run pytest); a concrete script operand is kept (bash scripts/check.sh). The rule is always a real prefix of
// the command, so it matches what actually runs.
function prefixOf(cmd) {
  const words = cmd.trim().split(/\s+/);
  const prog = words[0];
  if (/^[A-Za-z_][A-Za-z0-9_]*=/.test(prog)) return { rule: null, reason: 'starts with a variable assignment' };
  if (WRAPPERS.has(baseName(prog))) return { rule: null, reason: `${baseName(prog)} wraps another command` };
  if (!isRunner(prog)) {
    const keep = [prog];
    for (const w of words.slice(1)) {
      if (w.startsWith('-') || isGlob(w) || hasQuote(w) || w.includes('=')) break;
      keep.push(w);
      if (keep.length >= 3) break;
    }
    return { rule: keep.join(' ') };
  }
  const keep = [prog];
  let tool = '';
  let flags = 0;
  for (let i = 1; i < words.length; i++) {
    const w = words[i];
    if (INLINE_CODE.has(w)) return { rule: null, reason: `${baseName(prog)} ${w} runs inline code` };
    if (hasQuote(w) || isGlob(w)) break;
    if (w.startsWith('-')) {
      keep.push(w);
      flags++;
      if (VALUE_FLAGS.has(w) && words[i + 1] && !hasQuote(words[i + 1])) {
        keep.push(words[++i]);
        tool = words[i];
        if (!isRunner(tool)) break;
      }
      continue;
    }
    if (isPath(w)) {
      if (!tool) {
        keep.push(w); // a concrete script (bash scripts/check.sh, python manage.py) is specific
        tool = w;
      }
      break;
    }
    keep.push(w);
    if (RUNNER_SUBCOMMANDS.has(w) && !tool) continue;
    tool = w;
    if (!isRunner(w)) break;
  }
  if (tool && !isRunner(tool)) return { rule: keep.join(' ') };
  if (!tool && flags && keep.slice(1).every((w) => SAFE_FLAG_ONLY.has(w))) return { rule: keep.join(' ') };
  return { rule: null, reason: `no specific prefix for ${baseName(prog)}` };
}

// The origin (scheme://host[:port]) of a URL, or '' when it does not parse.
function originOf(url) {
  const m = /^(https?:\/\/[^/\s?#]+)/i.exec(String(url || ''));
  return m ? m[1] : '';
}

// Never emitted, whatever the config says.
const FORBIDDEN = /merge_pull_request|gh pr merge|--force|git push:\*|git push -u:\*/;

// {allow, manual}: manual lists commands with no safe specific prefix, for the user to allow by hand.
function allowPlan(config, opts = {}) {
  const c = config || {};
  const remote = (c.github && c.github.remote) || 'origin';
  const rules = new Set(GIT_RULES.map((g) => `Bash(${g}:*)`));
  const manual = [];
  rules.add(`Bash(git push -u ${remote}:*)`);
  rules.add(`Bash(git push ${remote}:*)`);
  // The read-only reviewer reads the issue with this and nothing else from gh.
  rules.add('Bash(gh issue view:*)');
  const commands = []
    .concat((Array.isArray(c.checks) ? c.checks : []).map((x) => x && x.run))
    .concat(c.verify && c.verify.devServer ? [c.verify.devServer.run] : [])
    .concat(c.worktree && Array.isArray(c.worktree.setup) ? c.worktree.setup : []);
  for (const run of commands) {
    for (const cmd of simpleCommands(run)) {
      const p = prefixOf(cmd);
      if (p.rule) rules.add(`Bash(${p.rule}:*)`);
      else if (!manual.some((m) => m.command === cmd)) manual.push({ command: cmd, reason: p.reason });
    }
  }
  const verify = c.verify || {};
  const modes = Array.isArray(verify.modes) ? verify.modes : [];
  if (modes.includes('http')) {
    const origin = originOf(verify.devServer && verify.devServer.url);
    if (origin) {
      rules.add(`Bash(curl ${origin}/*)`);
      rules.add(`Bash(curl * ${origin}/*)`);
    } else {
      rules.add('Bash(curl:*)');
    }
  }
  if (modes.includes('browser')) rules.add(verify.browserTool === 'chrome' ? 'mcp__claude-in-chrome__*' : 'mcp__playwright__*');
  rules.add(opts.githubMcp || 'mcp__github__*');
  for (const r of rules) if (FORBIDDEN.test(r)) rules.delete(r);
  return { allow: [...rules].sort(), manual };
}

function allowRules(config, opts = {}) {
  return allowPlan(config, opts).allow;
}

function deepEqual(a, b) {
  return JSON.stringify(a) === JSON.stringify(b);
}

const ALWAYS_KEEP = new Set(['$schema', 'devflowVersion']);

function strip(value, schema, top) {
  if (!value || typeof value !== 'object' || Array.isArray(value) || !schema || !schema.properties) return value;
  const required = new Set(schema.required || []);
  const out = {};
  for (const [key, v] of Object.entries(value)) {
    const sub = schema.properties[key];
    const keep = required.has(key) || (top && ALWAYS_KEEP.has(key));
    if (!sub) {
      out[key] = v; // unknown keys are left for validation to report
      continue;
    }
    if (!keep && 'default' in sub && deepEqual(v, sub.default)) continue;
    const stripped = sub.properties ? strip(v, sub, false) : v;
    if (!keep && sub.properties && stripped && typeof stripped === 'object' && !Array.isArray(stripped) && !Object.keys(stripped).length) continue;
    out[key] = stripped;
  }
  return out;
}

function minimalConfig(config, schema) {
  return strip(JSON.parse(JSON.stringify(config || {})), schema, true);
}

// Deny rules the guard hook already enforces: force pushes, merges, pushes to protected branches.
function guardDuplicate(rule, protectedNames) {
  const m = /^Bash\((.*)\)$/.exec(rule);
  if (!m) return /merge_pull_request/.test(rule);
  const cmd = m[1].replace(/:\*$/, '').trim();
  if (/^git push\b.*(--force|\s-f\b|\s\+)/.test(cmd)) return true;
  if (/^gh pr merge\b|^gh api\b.*merge/.test(cmd)) return true;
  if (/^git (reset --hard|clean|branch -D|add -A|add \.|add --all|stash (drop|clear))/.test(cmd)) return true;
  const push = /^git push\b(.*)$/.exec(cmd);
  if (push) {
    const words = push[1].trim().split(/\s+/);
    return words.some((w) => protectedNames.has(w.replace(/^.*:/, '')));
  }
  return false;
}

function ownedLeftovers({ settings, config, files } = {}) {
  const out = [];
  const s = settings || {};
  const c = config || {};
  const list = Array.isArray(files) ? files : [];
  const protectedNames = new Set((Array.isArray(c.protectedBranches) ? c.protectedBranches : ['main', 'master', 'develop']).concat(c.baseBranch ? [c.baseBranch] : []));
  for (const f of list) {
    if (/(^|\/)\.claude\/hooks\/(test_)?block_git_add_all\.py$/.test(f)) {
      out.push({ what: f, why: 'the plugin guard blocks git add -A / --all / . (its cases are in hooks/test_guard.py)' });
    } else if (/(^|\/)\.claude\/loop\.md$/.test(f)) {
      out.push({ what: f, why: 'maintenance loop prompt: use /loop 15m /devflow:sync --unattended and /devflow:doctor instead' });
    } else if (/(^|\/)\.claude\/agents\/code-reviewer\.md$/.test(f)) {
      out.push({ what: f, why: 'the plugin ships the devflow:reviewer agent used by the Review stage and for local reviews' });
    }
  }
  for (const [event, entries] of Object.entries((s.hooks && typeof s.hooks === 'object' && s.hooks) || {})) {
    for (const entry of Array.isArray(entries) ? entries : []) {
      for (const h of (entry && entry.hooks) || []) {
        if (/block_git_add_all\.py/.test(String(h.command || ''))) {
          out.push({ what: 'settings.json hook running block_git_add_all.py', why: `${event} hook duplicated by the plugin guard` });
        }
      }
    }
  }
  for (const check of Array.isArray(c.checks) ? c.checks : []) {
    if (check && (/^hook-?test/.test(String(check.name || '')) || /block_git_add_all|\.claude\/hooks/.test(String(check.run || '')))) {
      out.push({ what: `checks entry "${check.name}"`, why: 'it tests the project hook the plugin guard replaces' });
    }
  }
  const deny = (s.permissions && Array.isArray(s.permissions.deny) && s.permissions.deny) || [];
  for (const rule of deny) {
    if (guardDuplicate(String(rule), protectedNames)) out.push({ what: `deny rule ${rule}`, why: 'the plugin guard hook already blocks it' });
  }
  return out;
}

if (require.main !== module) {
  module.exports = { allowRules, allowPlan, minimalConfig, ownedLeftovers, simpleCommands, prefixOf, originOf };
} else {
  const argv = process.argv.slice(2);
  if (!argv.length || argv.some((a) => a === '--help' || a === '-h')) {
    console.log(USAGE);
    process.exit(argv.length ? 0 : 1);
  }
  let data = '';
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', (chunk) => (data += chunk));
  process.stdin.on('end', () => {
    try {
      const input = JSON.parse(data);
      let out;
      if (argv[0] === 'allow') {
        const i = argv.indexOf('--github-mcp');
        const plan = allowPlan(input, { githubMcp: i !== -1 ? argv[i + 1] : undefined });
        // manual: commands with no safe specific prefix; the user allows them by hand.
        out = { permissions: { allow: plan.allow }, manual: plan.manual };
      } else if (argv[0] === 'minimal') {
        if (!argv[1]) throw new Error('minimal needs the schema path');
        out = minimalConfig(input, JSON.parse(require('fs').readFileSync(argv[1], 'utf8')));
      } else if (argv[0] === 'leftovers') {
        out = ownedLeftovers(input);
      } else {
        throw new Error(`unknown command ${argv[0]}`);
      }
      process.stdout.write(JSON.stringify(out, null, 2) + '\n');
    } catch (e) {
      console.error(`devflow-setup: ${e.message}`);
      process.exit(1);
    }
  });
}
