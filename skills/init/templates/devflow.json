{
  // Annotated example. init writes plain JSON (no comments) to .claude/devflow.json.
  "$schema": "./devflow.schema.json",
  // The plugin version the templates were installed from (written by /devflow:init, updated by /devflow:init --upgrade).
  "devflowVersion": "2.6.0",
  // remote = the git remote that points at GitHub
  "github": { "owner": "acme", "repo": "shop", "remote": "origin" },
  // Branches start from <remote>/<baseBranch>; PRs target it.
  "baseBranch": "main",
  // The guard hook blocks pushes to these and to baseBranch.
  "protectedBranches": ["main", "develop"],
  // type is one of feat|fix|chore|docs|refactor|test; slug is at most 5 words, kebab-case.
  "branchPattern": "{type}/{issue}-{slug}",
  // Conventional Commits scope, e.g. feat(#12): ...
  "commitScope": "#{issue}",
  "specDir": "docs/specs",
  "labels": {
    "ready": "agent:ready",
    "inProgress": "agent:in-progress",
    "review": "agent:review",
    "blocked": "agent:blocked",
    "e2e": "needs-e2e",
    // devflow: on every PR devflow opens. riskLow/riskHigh: set by /devflow:spec on issues, copied to PRs.
    // stacked: PR based on another open devflow PR.
    "devflow": "devflow",
    "riskLow": "risk:low",
    "riskHigh": "risk:high",
    "stacked": "stacked"
  },
  // Unsure means high. highPaths are globs (** * ?): a PR touching one is escalated to high before it is opened.
  "risk": {
    "highWhen": [
      "authentication or permissions",
      "data migration or deleting stored data",
      "a change to a public API contract that breaks existing clients",
      "security-sensitive input handling",
      "payments or money"
    ],
    "highPaths": []
  },
  // Read by the merge gate GitHub Action (Claude itself never merges). Only risk:low PRs are merged.
  // dryRun logs what would be merged. requiredChecks = check run names or commit-status contexts that must be green.
  // method "merge": merge commits are required for stacked PRs.
  "mergeGate": { "enabled": false, "dryRun": true, "requiredChecks": ["devflow/review"], "method": "merge" },
  // e2eFramework: true when the project has an automated e2e/browser test setup that can hold committed e2e tests.
  "testing": { "e2eFramework": false },
  // Run in order; all must pass before review. Use the project's own commands.
  "checks": [
    { "name": "test", "run": "npm test" },
    { "name": "lint", "run": "npm run lint" }
  ],
  "verify": {
    // Subset of "http" | "browser"; [] disables verification.
    "modes": ["http", "browser"],
    "devServer": { "run": "npm run dev", "url": "http://localhost:3000", "readyTimeoutSec": 60 },
    // "playwright" (Playwright MCP) or "chrome" (Claude in Chrome)
    "browserTool": "playwright",
    // Only one session at a time runs Verify on this machine (a lock under the git common dir), so parallel lanes
    // do not fight over the dev server port.
    "lock": true
  },
  // QA step of /devflow:spec: draft a test matrix from the acceptance criteria. qaModel is "opus" or "sonnet".
  "spec": { "testMatrix": true, "qaModel": "opus" },
  // parallelQa: a QA agent writes the acceptance tests from the spec while the dev agent implements (default true).
  "nextTask": { "defaultLimit": 3, "maxFixRounds": 2, "maxReviewRounds": 2, "parallelQa": true },
  // Parallel sessions: each ticket runs in its own git worktree under dir. setup commands run once in a fresh worktree.
  "worktree": { "dir": ".claude/worktrees", "setup": ["npm ci"] },
  // /devflow:dispatch: at most maxLanes background sessions at once. pluginDir (optional) is passed as --plugin-dir
  // to those sessions when the plugin is loaded from a local directory.
  // ignoreHotspots: hotspots matching these paths or globs (* and **) do not join lanes; conflicts there are small and
  // resolved by the merge gate's branch update or /devflow:sync.
  "dispatch": { "maxLanes": 3, "ignoreHotspots": ["README.md", "CHANGELOG.md"] },
  // Push notification (Claude Code PushNotification tool) when a run ends with a blocked issue, a risk:high PR waiting
  // for a human, or at the end of a lane. The other three switch each event on or off.
  "notify": { "push": true, "onDone": true, "onBlocked": true, "onHighRisk": true },
  // /devflow:release: tag = tagPrefix + version. draft: the GitHub release is created as a draft; a human publishes it.
  // deploy: optional shell command run after the release, only after the user says yes. notesFrom: "prs".
  "release": { "tagPrefix": "v", "draft": true, "deploy": "", "notesFrom": "prs" },
  // /devflow:accept: model is "sonnet" or "opus"; labels are added to the gap issues it files.
  "accept": { "model": "sonnet", "labels": ["type:gap"] }
}
