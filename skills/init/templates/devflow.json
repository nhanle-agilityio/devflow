{
  // Annotated example. init writes plain JSON (no comments) to .claude/devflow.json.
  "$schema": "./devflow.schema.json",
  // The plugin version the templates were installed from (written by /devflow:init, updated by /devflow:init --upgrade).
  "devflowVersion": "3.4.0",
  // remote = the git remote that points at GitHub
  "github": { "owner": "acme", "repo": "shop", "remote": "origin" },
  // Branches start from <remote>/<baseBranch>; PRs target it.
  "baseBranch": "main",
  // The guard hook blocks pushes to these and to baseBranch.
  "protectedBranches": ["main", "develop"],
  // type is one of feat|fix|chore|docs|refactor|test; slug is at most 5 words, kebab-case.
  "branchPattern": "{type}/{issue}-{slug}",
  // Conventional Commits scope, e.g. feat(#12): ...
  "commitScope": "#{issue}",
  "specDir": "docs/specs",
  "labels": {
    "epicApproved": "epic:approved", // explicit human approval for epic auto-readying
    "ready": "agent:ready",
    "inProgress": "agent:in-progress",
    "review": "agent:review",
    "blocked": "agent:blocked",
    "e2e": "needs-e2e",
    // devflow: on every PR devflow opens. riskLow/riskHigh: set by /devflow:spec on issues, copied to PRs.
    // stacked: PR based on another open devflow PR.
    "devflow": "devflow",
    "riskLow": "risk:low",
    "riskHigh": "risk:high",
    "stacked": "stacked",
    // triage: bugs and gaps nobody triaged yet; next-task never picks them, a human swaps it for ready.
    "triage": "needs-triage",
    // decisionsReview: PR label when the run took a decision itself (see nextTask.onQuestion).
    "decisionsReview": "decisions:review",
    // priority: highest first; no label = the "normal" entry. Orders next-task and the merge gate, never who merges.
    "priority": ["priority:critical", "priority:high", "priority:normal", "priority:low"]
  },
  // Unsure means high. highPaths are globs (** * ?): a PR touching one is escalated to high before it is opened.
  "risk": {
    "highWhen": [
      "authentication or permissions",
      "data migration or deleting stored data",
      "a change to a public API contract that breaks existing clients",
      "security-sensitive input handling",
      "payments or money"
    ],
    "highPaths": []
  },
  // Read by the merge gate GitHub Action (Claude itself never merges). Only risk:low PRs are merged.
  // dryRun logs what would be merged. requiredChecks = check run names or commit-status contexts that must be green.
  // method "merge": merge commits are required for stacked PRs.
  "mergeGate": { "enabled": false, "dryRun": true, "requiredChecks": ["devflow/review"], "method": "merge" },
  // review.github: true runs the GitHub review workflow (devflow/review status, claude-code-action) on PRs. Default false:
  // the workflow skips (no Claude call, no status) and the engine's local review (devflow:reviewer) is the only review.
  // With true, keep "devflow/review" in mergeGate.requiredChecks. Read from the default-branch / baseBranch copy, never the PR head.
  "review": { "github": false },
  // e2eFramework: true when the project has an automated e2e/browser test setup that can hold committed e2e tests.
  "testing": { "e2eFramework": false },
  // Run in order; all must pass before review. Use the project's own commands.
  // Optional timeoutSeconds sets a per-command limit in seconds (default 600).
  // The test check can set redRun for the QA commit's red check, with {files} for the shell-quoted QA paths.
  "checks": [
    { "name": "test", "run": "npm test" },
    { "name": "lint", "run": "npm run lint" }
  ],
  // Formatters the plugin runs after Claude edits a file (glob -> command, {file} = path from the project root).
  // Quiet and never fails the edit. Leave it out when the project formats in its checks only.
  "format": { "*.ts": "npx prettier -w {file}", "*.js": "npx prettier -w {file}" },
  "verify": {
    // Subset of "http" | "browser"; [] disables verification.
    "modes": ["http", "browser"],
    "devServer": { "run": "npm run dev", "url": "http://localhost:3000", "readyTimeoutSec": 60 },
    // "playwright" (Playwright MCP) or "chrome" (Claude in Chrome)
    "browserTool": "playwright",
    // Only one session at a time runs Verify on this machine (a lock under the git common dir), so parallel lanes
    // do not fight over the dev server port.
    "lock": true
  },
  // QA step of /devflow:spec: draft a test matrix from the acceptance criteria. qaModel is "opus" or "sonnet".
  // autoReady: "off" keeps manual readiness, "low" requires risk:low, "all" allows any risk after epic approval.
  "spec": { "testMatrix": true, "qaModel": "opus", "autoReady": "off" },
  // reviewerAgent: the subagent type Review runs as ("" = the default agent).
  // parallelQa: a QA agent writes the acceptance tests from the spec while the dev agent implements (default true).
  // onQuestion: decide (default) = the run takes the recommended option, records it under "Decisions" and labels the PR
  // decisionsReview; a review warning left after maxReviewRounds ships the same way. decide-high (a product decision, or a change to
  // a criterion, contract or stored format, lowered risk, or a risk.highPaths file) is recorded as [needs human review] and the PR
  // becomes risk:high. block = a question that is not reversible, skips a check, drops a must row, needs destructive git, is outside
  // the repo or is malformed (secrets, credentials and permission problems also stop the task); onQuestion "block" blocks every
  // question and leftover warning (3.0.0). trustDecisions: false = the merge gate leaves risk:low decisionsReview PRs to a human;
  // decide-high PRs are risk:high, so a human merges them either way.
  // reviewModel: Sonnet for low risk and Opus for high or unknown risk. Override either model independently.
  // maxAgentCalls: block an issue when it reaches this many agent calls, with cleanup exempt. Zero disables the limit.
  "nextTask": { "defaultLimit": 3, "maxFixRounds": 2, "maxReviewRounds": 2, "reviewModel": { "low": "sonnet", "high": "opus" }, "maxAgentCalls": 0, "parallelQa": true, "reviewerAgent": "devflow:reviewer", "onQuestion": "decide", "trustDecisions": false },
  // Parallel sessions: each ticket runs in its own git worktree under dir. setup commands run once in a fresh worktree.
  "worktree": { "dir": ".claude/worktrees", "setup": ["npm ci"] },
  // /devflow:dispatch: at most maxLanes background sessions at once. pluginDir (optional) is passed as --plugin-dir
  // to those sessions when the plugin is loaded from a local directory.
  // ignoreHotspots: hotspots matching these paths or globs (* and **) do not join lanes; conflicts there are small and
  // resolved by the merge gate's branch update or /devflow:sync. With changelog.fragmentsDir set,
  // the fragment directory never needs a lane: list `<fragmentsDir>/**` here (one file per issue).
  "dispatch": { "maxLanes": 3, "ignoreHotspots": ["README.md", "CHANGELOG.md"] },
  // Omit autopilot.maxLanes to inherit dispatch.maxLanes (default 3). Each lane start costs one agent call.
  // Running issues with no commit or comment for longer than stallHours appear in the epic's progress table.
  "autopilot": { "maxLanes": 3, "maxAgentCallsPerTick": 20, "stallHours": 12 },
  // Weakened-checks scan: files matching these globs (** * ?) are skipped entirely, e.g. a test file whose fixture data
  // holds the scanned patterns. .claude/devflow.json is never ignored, so editing this list is itself a scan hit.
  "scan": { "ignore": [] },
  // Push notification (Claude Code PushNotification tool) when a run ends with a blocked issue, a risk:high PR waiting
  // for a human, or at the end of a lane. The other three switch each event on or off.
  "notify": { "push": true, "onDone": true, "onBlocked": true, "onHighRisk": true },
  // /devflow:release: tag = tagPrefix + version. draft: the GitHub release is created as a draft; a human publishes it.
  // deploy: optional shell command run after the release, only after the user says yes. notesFrom: "prs".
  "release": { "tagPrefix": "v", "draft": true, "deploy": "", "notesFrom": "prs" },
  // Changelog fragments (bin/devflow-changelog): one <issue number>.md per issue in fragmentsDir, with "### Added" style
  // headings and "- " bullets; assemble writes them into "file" below "## [Unreleased]". fragmentsDir has no default: ""
  // (or no changelog object) means off.
  "changelog": { "fragmentsDir": "", "file": "CHANGELOG.md" },
  // /devflow:accept: model is "sonnet" or "opus"; labels are added to the gap issues it files.
  "accept": { "model": "sonnet", "labels": ["type:gap"] }
}
